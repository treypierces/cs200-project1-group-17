digraph ChocAn {
rankdir=LR; newrank=true; nodesep=0.5; ranksep=1.4; splines=ortho; forcelabels=true;
graph [fontname="Helvetica" fontsize=24 labelloc=t label="ChocAn System: Final UML Class Diagram (Team 17, Project 4)\nMain creates every repository, controller, and terminal. Repositories and ProviderDirectory use DataFile to save and SeedData on first run. Underlined = static.\n\n"];
node [shape=plain fontname="Helvetica" fontsize=11];
edge [fontname="Helvetica" fontsize=9 color="#555555"];
subgraph cluster_app { label="chocan"; fontsize=16; style=rounded; color="#999999";
"Main" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Main</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ main(args : String[]) : void</U></TD></TR></TABLE>> style=filled fillcolor="#F2F2F2"];
}
subgraph cluster_boundary { label="chocan.boundary"; fontsize=16; style=rounded; color="#999999";
"Terminal" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;boundary&raquo;<BR/><I><B>Terminal</B></I></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># userNumber : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># verified : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- scanner : Scanner</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ start(numberPrompt : String) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># verify(number : String) : boolean {abstract}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># welcomeName(number : String) : String {abstract}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ showMainMenu() : void {abstract}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ display(message : String) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ readInput(prompt : String) : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># readChoice(prompt, min, max) : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># confirm(question : String) : boolean</TD></TR></TABLE>> style=filled fillcolor="#F6ECFA"];
"ProviderTerminal" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;boundary&raquo;<BR/><B>ProviderTerminal</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- verifier : VerifyController</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- memberCtl : MemberController</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- serviceCtl : ServiceController</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ verifyProvider(providerNumber : String) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># verify(number) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># welcomeName(number) : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ showMainMenu() : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validateMember(memberNumber : String) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ billForService(memberNumber : String) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ requestProviderDirectory() : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- readServiceDate() : LocalDate</TD></TR></TABLE>> style=filled fillcolor="#F6ECFA"];
"OperatorTerminal" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;boundary&raquo;<BR/><B>OperatorTerminal</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- verifier : VerifyController</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- memberCtl : MemberController</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- providerCtl : ProviderController</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ verifyOperator(operatorNumber : String) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># verify(number) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># welcomeName(number) : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ showMainMenu() : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addMember() : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ updateMember(memberNumber : String) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ deleteMember(memberNumber : String) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ listMembers() : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addProvider() : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ updateProvider(providerNumber : String) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ deleteProvider(providerNumber : String) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ listProviders() : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- enterData(current : Person, isMember : boolean) : Object[]</TD></TR></TABLE>> style=filled fillcolor="#F6ECFA"];
"ManagerTerminal" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;boundary&raquo;<BR/><B>ManagerTerminal</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- verifier : VerifyController</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- reportCtl : ReportController</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ verifyManager(managerNumber : String) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># verify(number) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># welcomeName(number) : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ showMainMenu() : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ runWeeklyAccounting() : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ requestMemberReport() : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ requestProviderReport() : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ requestSummaryReport() : void</TD></TR></TABLE>> style=filled fillcolor="#F6ECFA"];
}
subgraph cluster_control { label="chocan.control"; fontsize=16; style=rounded; color="#999999";
"VerifyController" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;control&raquo;<BR/><B>VerifyController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- providerRepo : ProviderRepository</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- staffAccounts : List&lt;StaffAccount&gt;</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ verifyProvider(providerNumber : String) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ verifyOperator(operatorNumber : String) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ verifyManager(managerNumber : String) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getUserName(number : String) : String</TD></TR></TABLE>> style=filled fillcolor="#FFF6E5"];
"MemberController" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;control&raquo;<BR/><B>MemberController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- memberRepo : MemberRepository</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validateMember(memberNumber : String) : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validateData(name : String, address : Address) : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addMember(name : String, address : Address) : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getMember(memberNumber : String) : Member</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ updateMember(memberNumber, name, address) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ deleteMember(memberNumber : String) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ updateMemberStatus(memberNumber : String, feesPaid : boolean) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ listMembers() : List&lt;Member&gt;</TD></TR></TABLE>> style=filled fillcolor="#FFF6E5"];
"ProviderController" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;control&raquo;<BR/><B>ProviderController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- providerRepo : ProviderRepository</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validateData(name : String, address : Address) : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addProvider(name : String, address : Address) : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getProvider(providerNumber : String) : Provider</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ updateProvider(providerNumber, name, address) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ deleteProvider(providerNumber : String) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ listProviders() : List&lt;Provider&gt;</TD></TR></TABLE>> style=filled fillcolor="#FFF6E5"];
"ServiceController" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;control&raquo;<BR/><B>ServiceController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- directory : ProviderDirectory</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- recordRepo : ServiceRecordRepository</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getServiceName(serviceCode : String) : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ billService(memberNumber, providerNumber, serviceDate, serviceCode, comments) : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ requestProviderDirectory() : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getDirectoryListing() : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getDirectoryFileName() : String</TD></TR></TABLE>> style=filled fillcolor="#FFF6E5"];
"ReportController" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;control&raquo;<BR/><B>ReportController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- recordRepo : ServiceRecordRepository</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- memberRepo : MemberRepository</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- providerRepo : ProviderRepository</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- directory : ProviderDirectory</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- reportsDir : Path</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ runWeeklyAccounting() : List&lt;ReportFile&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ generateMemberReport() : List&lt;ReportFile&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ generateProviderReport() : List&lt;ReportFile&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ generateSummaryReport() : ReportFile</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ generateEFTRecord() : ReportFile</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- groupByMember(records) : Map</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- groupByProvider(records) : Map</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- totalFee(records) : double</TD></TR></TABLE>> style=filled fillcolor="#FFF6E5"];
}
subgraph cluster_data { label="chocan.data"; fontsize=16; style=rounded; color="#999999";
"MemberRepository" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;entity&raquo;<BR/><B>MemberRepository</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fileName : Path</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- members : List&lt;Member&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nextNumber : long</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ findMember(memberNumber : String) : Member</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getMemberStatus(memberNumber : String) : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ nextMemberNumber() : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addMember(member : Member) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ saveMember(member : Member) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ removeMember(memberNumber : String) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getAllMembers() : List&lt;Member&gt;</TD></TR></TABLE>> style=filled fillcolor="#EEF7EA"];
"ProviderRepository" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;entity&raquo;<BR/><B>ProviderRepository</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fileName : Path</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- providers : List&lt;Provider&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nextNumber : long</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ findProvider(providerNumber : String) : Provider</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ nextProviderNumber() : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addProvider(provider : Provider) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ saveProvider(provider : Provider) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ removeProvider(providerNumber : String) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getAllProviders() : List&lt;Provider&gt;</TD></TR></TABLE>> style=filled fillcolor="#EEF7EA"];
"ServiceRecordRepository" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;entity&raquo;<BR/><B>ServiceRecordRepository</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fileName : Path</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- records : List&lt;ServiceRecord&gt;</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addRecord(record : ServiceRecord) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getWeekRecords() : List&lt;ServiceRecord&gt;</TD></TR></TABLE>> style=filled fillcolor="#EEF7EA"];
"DataFile" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;utility&raquo;<BR/><B>DataFile</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ exists(file : Path) : boolean</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ readRows(file : Path) : List&lt;String[]&gt;</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ writeRows(file : Path, lines : List) : boolean</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ writeText(file : Path, text : String) : boolean</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ join(fields : String...) : String</U></TD></TR></TABLE>> style=filled fillcolor="#EEF7EA"];
"SeedData" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;utility&raquo;<BR/><B>SeedData</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ staffAccounts() : List</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ members() : List</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ providers() : List</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ services() : List</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ records() : List</U></TD></TR></TABLE>> style=filled fillcolor="#EEF7EA"];
}
subgraph cluster_entity { label="chocan.entity"; fontsize=16; style=rounded; color="#999999";
"Person" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;entity&raquo;<BR/><I><B>Person</B></I></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># name : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># number : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># address : Address</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getName() : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getNumber() : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getAddress() : Address</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ update(name : String, address : Address) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ checkData(name, address) : String</U></TD></TR></TABLE>> style=filled fillcolor="#EAF2FB"];
"Address" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;entity&raquo;<BR/><B>Address</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- street : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- city : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- state : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- zip : String</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Address(street, city, state, zip)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getters</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ check() : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ toString() : String</TD></TR></TABLE>> style=filled fillcolor="#EAF2FB"];
"Member" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;entity&raquo;<BR/><B>Member</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- status : String  (ACTIVE / SUSPENDED)</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Member(number, name, address, status)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getStatus() : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setStatus(status : String) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ isActive() : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ toString() : String</TD></TR></TABLE>> style=filled fillcolor="#EAF2FB"];
"Provider" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;entity&raquo;<BR/><B>Provider</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Provider(number, name, address)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ toString() : String</TD></TR></TABLE>> style=filled fillcolor="#EAF2FB"];
"StaffAccount" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;entity&raquo;<BR/><B>StaffAccount</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- staffNumber : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- role : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- name : String</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ matches(staffNumber : String, role : String) : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getName() : String</TD></TR></TABLE>> style=filled fillcolor="#EAF2FB"];
"Service" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;entity&raquo;<BR/><B>Service</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- code : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- name : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fee : double</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getCode() : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getName() : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getFee() : double</TD></TR></TABLE>> style=filled fillcolor="#EAF2FB"];
"ServiceRecord" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;entity&raquo;<BR/><B>ServiceRecord</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- receivedDateTime : LocalDateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- serviceDate : LocalDate</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- providerNumber : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- memberNumber : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- serviceCode : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fee : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- comments : String</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ServiceRecord(serviceDate, providerNumber, memberNumber, serviceCode, fee, comments)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getters</TD></TR></TABLE>> style=filled fillcolor="#EAF2FB"];
"ProviderDirectory" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;entity&raquo;<BR/><B>ProviderDirectory</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- services : List&lt;Service&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- dataFile : Path</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fileName : Path</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ findService(serviceCode : String) : Service</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getFee(serviceCode : String) : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ sortByName() : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getListing() : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ writeFile() : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getFileName() : Path</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ money(amount : double) : String</U></TD></TR></TABLE>> style=filled fillcolor="#EAF2FB"];
}
subgraph cluster_reports { label="chocan.reports"; fontsize=16; style=rounded; color="#999999";
"ReportFile" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;entity&raquo;<BR/><I><B>ReportFile</B></I></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># fileName : Path</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># reportDate : LocalDate</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getContent() : String {abstract}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ writeFile() : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getFileName() : Path</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U># nameForFile(name : String) : String</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># weekLine() : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U># personBlock(label : String, p : Person) : String</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U># dashes(n : int) : String</U></TD></TR></TABLE>> style=filled fillcolor="#FDEDEC"];
"MemberReport" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;entity&raquo;<BR/><B>MemberReport</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- member : Member</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- services : List&lt;ServiceRecord&gt;</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ MemberReport(member, services, providerRepo, directory, reportsDir)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getContent() : String</TD></TR></TABLE>> style=filled fillcolor="#FDEDEC"];
"ProviderReport" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;entity&raquo;<BR/><B>ProviderReport</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- provider : Provider</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- services : List&lt;ServiceRecord&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- totalConsultations : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- totalFee : double</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ProviderReport(provider, services, memberRepo, reportsDir)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getContent() : String</TD></TR></TABLE>> style=filled fillcolor="#FDEDEC"];
"SummaryReport" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;entity&raquo;<BR/><B>SummaryReport</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- byProvider : Map&lt;String, List&lt;ServiceRecord&gt;&gt;</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ SummaryReport(byProvider, providerRepo, reportsDir)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getContent() : String</TD></TR></TABLE>> style=filled fillcolor="#FDEDEC"];
"EFTRecord" [label=<<TABLE BORDER="1" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD>&laquo;entity&raquo;<BR/><B>EFTRecord</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- entries : List&lt;String&gt;</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ EFTRecord(reportsDir)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addEntry(providerName, providerNumber, amount) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getContent() : String</TD></TR></TABLE>> style=filled fillcolor="#FDEDEC"];
}
